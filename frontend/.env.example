# Copy to frontend/.env for local development. Never commit .env.
# Vite copies these values into the app's code, where anyone can read them: never put a secret here.

# The API's address.
VITE_API_URL=http://localhost:8000
# Clerk publishable key (pk_test_...) of our development instance, from the team. Public by design,
# unlike the secret key (sk_test_...), which only the API uses (root /.env). Required for sign-in.
VITE_CLERK_PUBLISHABLE_KEY=
