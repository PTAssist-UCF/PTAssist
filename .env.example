# Copy to .env for local development. Never commit .env.
# Frontend variables live in frontend/.env.example.

# Database: the Postgres in Docker Compose, which is on port 5434 of your computer.
# "+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ptassist:ptassist@localhost:5434/ptassist
# Backend tests only: a separate database that every test run wipes (see backend/README.md).
TEST_DATABASE_URL=postgresql+psycopg://ptassist:ptassist@localhost:5433/ptassist_test

# Clerk (get values from the team, never paste them in code)
# Secret key (sk_test_...). The API uses it to check tokens and look up new users' emails.
CLERK_SECRET_KEY=
# Web app origins allowed to call the API, comma-separated. Tokens from other origins get 401.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Storage (Azurite, the Azure Storage emulator, locally; Azure Blob storage in the cloud)
# Connection string. UseDevelopmentStorage=true means Azurite on 127.0.0.1:10000. In Azure
# it is the storage account's connection string, which holds its key: a secret. Wrap
# values that contain ";" in double quotes.
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Private blob container for the videos. The API creates it if it is missing.
STORAGE_CONTAINER=videos
# Backend tests only: the Azurite that tests make and delete their own containers in.
TEST_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Docker Compose only: Azurite's well-known account key, which the API container needs to
# reach Azurite (see backend/README.md, Storage in Docker Compose). It is public, not a
# secret, but GitHub secret scanning flags it, so it is not in the repo. Copy the
# "Account key" from https://learn.microsoft.com/azure/storage/common/storage-connect-azurite#use-a-well-known-storage-account-and-key
# Without it the stack still starts, but storage calls in the Compose API fail.
AZURITE_ACCOUNT_KEY=

# AI service
AI_SERVICE_URL=http://localhost:8001
